# ============================================================================
# FILE: /apps/api/.env.example
# ============================================================================
# Copy to .env and fill in. NEVER commit the real .env file.
# This example is committed so the shape of every secret is documented.

# ─── Environment ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:3001

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge_nova

# ─── JWT ─────────────────────────────────────────────────────────────────────
AUTH_JWT_SECRET=change-me-to-a-64-char-random-string

# ─── Google OAuth (console.cloud.google.com → Credentials) ─────────────────
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ─── Facebook OAuth (developers.facebook.com → Facebook Login) ──────────────
AUTH_FACEBOOK_CLIENT_ID=
AUTH_FACEBOOK_CLIENT_SECRET=
AUTH_FACEBOOK_CALLBACK_URL=http://localhost:3000/api/v1/auth/facebook/callback

# ─── Scanner provider keys (platform-level; BYOK users bring their own) ─────
EGRESS_TWITTER_BEARER_TOKEN=
EGRESS_REDDIT_CLIENT_ID=
EGRESS_REDDIT_CLIENT_SECRET=
EGRESS_GOOGLE_API_KEY=
EGRESS_GOOGLE_SEARCH_CX=
EGRESS_GITHUB_TOKEN=
